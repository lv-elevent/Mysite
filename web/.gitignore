node_modules
dist
dist-ssr
*.tsbuildinfo
.DS_Store

# Vite 在加载 vite.config.ts 时会生成临时文件，正常会自动清理；
# 进程被强杀（如 Ctrl+C 中断构建）时会残留，不应入库
vite.config.ts.timestamp-*.mjs
*.local
.vite
.playwright-mcp
*.log

# 作品媒体（视频/大图）：体积大且属个人内容，不入 git。
# 仅保留板块封面占位图（public/works/covers/），其余媒体请自行放置或走 CDN。
public/works/*
!public/works/covers/

# 压缩脚本日志
scripts/compress-media.log

# 诊断脚本的截图产物（cdp-shot / cdp-transition / strip 的输出）：纯本地排查用，不入库
shots/

# 本地工具与部署产物（含本地路径/服务器信息，不入库）
.claude/
deploy/
